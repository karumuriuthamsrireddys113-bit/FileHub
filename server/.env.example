# ==========================================================
# FileHub Backend Server Environment Configuration
# ==========================================================

# Server Listening Port (Automatically assigned by Render in production, defaults to 5001 locally)
PORT=5001

# Runtime Environment ('development' or 'production')
NODE_ENV=development

# JSON Web Token Secret for signing authentication cookies
JWT_SECRET=replace-with-a-secure-random-secret-key-in-production

# Allowed CORS Origins (comma-separated list for production, or '*' for wildcard)
# Example for production: https://your-filehub-client.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=*

# MongoDB Connection String
# Required in production. Prisma requires a MongoDB Replica Set connection (MongoDB Atlas provides this by default).
# Format for MongoDB Atlas:
# DATABASE_URL="mongodb+srv://<db_user>:<db_password>@<cluster-name>.mongodb.net/filehub?retryWrites=true&w=majority"
#
# NOTE: For local development, if DATABASE_URL is left blank, FileHub will automatically launch
# an embedded MongoDB replica set using mongodb-memory-server.
DATABASE_URL=
